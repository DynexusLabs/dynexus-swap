{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Aptos private key",
            "pattern": "/ed25519-priv-0x[0-9a-fA-F]{64}/"
          },
          {
            "name": "Raw 32-byte hex private key assignment",
            "pattern": "/(private_key|PRIVATE_KEY)\\s*[:=]\\s*[\"']?0x[0-9a-fA-F]{64}/"
          }
        ]
      }
    }
  ]
}
